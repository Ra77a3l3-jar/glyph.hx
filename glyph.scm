        'star (cons "󰌶" "#eca517")
        'check (cons "󰄬" "#4caf50")
        'close (cons "󰅖" "#6d8086")))

(define (glyph-ui-icon key)
  (let ([entry (hash-try-get *glyph-ui-icons* key)])
    (if entry (car entry) DEFAULT-UI-ICON)))

(define (glyph-ui-color key)
  (let ([entry (hash-try-get *glyph-ui-icons* key)])
    (if entry (cdr entry) DEFAULT-UI-COLOR)))

